  "think": {
    "intro": "作業台に、集めた物を並べた。家出人の届、千草さんの日記、揚げ戸の古い札、婚礼の写真。……五十二年前に何が起きたのか、一つずつ確かめる。",
    "questions": [
      {
        "q": "千草さんは、昭和四十九年十一月十四日のあと、どこにいたのか。",
        "options": [
          {
            "id": "away",
            "label": "家出して、男の人と遠くへ行った（家出人の届のとおり）",
            "why": "届を出したのはハルさん本人だ。奥の室の着物の帯留めには、何と彫ってあった？"
          },
          {
            "id": "home",
            "label": "実家に帰った",
            "why": "実家のことは、どこにも出てこなかった。奥の室で見たものを思い出そう。"
          },
          {
            "id": "muro",
            "label": "地下の奥の室にいて、そこで亡くなった",
            "ok": true,
            "why": "奥の室の着物の帯留めに「千草」。指の骨は、棚の箱へ伸びていた。"
          }
        ]
      },
      {
        "q": "千草さんは、なぜ地下から出られなかったのか。",
        "options": [
          {
            "id": "lost",
            "label": "長い通路で道に迷った",
            "why": "通路は一本道だった。室の揚げ戸の裏には、何があった？"
          },
          {
            "id": "shut",
            "label": "揚げ戸を上から札で封じられ、石の臼で押さえられた",
            "ok": true,
            "why": "揚げ戸の札は上から貼ってあり、上には臼。裏板には、下からかいた爪あと。"
          },
          {
            "id": "hurt",
            "label": "足をけがして、歩けなくなった",
            "why": "けがのことは、どこにもなかった。揚げ戸の札が貼ってあった向きを思い出そう。"
          }
        ]
      },
      {
        "q": "揚げ戸に札を貼ったのは誰か。",
        "options": [
          {
            "id": "seiji",
            "label": "夫の清次さん",
            "why": "仏壇の位牌では、清次さんは十月三日に亡くなっている。札の日付は十一月十四日だ。"
          },
          {
            "id": "temple",
            "label": "札を書いた寺の人",
            "why": "寺の人が、千草さんを下へ行かせる理由がない。日記で千草さんに「持って来い」と言ったのは？"
          },
          {
            "id": "haru",
            "label": "ハルさん",
            "ok": true,
            "why": "日記では、十一月十四日にハルさんが「奥の棚から持って来い」と言った。札の日付も同じ日。家出の届も、二日後にハルさんが出した。"
          }
        ]
      },
      {
        "q": "ハルさんは、なぜ今になって櫛を欲しがるのか。",
        "options": [
          {
            "id": "keep",
            "label": "息子の形見として、手もとに置きたい",
            "why": "ハルさんは櫛を「苦死」と呼んで嫌っていた。櫛がある限り、あの女は離れん、とも言った。"
          },
          {
            "id": "burn",
            "label": "燃やして、千草さんを消すため",
            "ok": true,
            "why": "千草さんは、櫛のある所へ来る。死んで千草さんと同じ側に来たハルさんは、それが怖い。"
          },
          {
            "id": "sell",
            "label": "売ってお金にするため",
            "why": "ハルさんはもう亡くなっている。櫛がある限り、あの女は離れん、と言った。"
          }
        ]
      }
    ]
  }
}
