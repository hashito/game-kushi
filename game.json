{
  "id": "kushi",
  "title": "札の家 ― 奥の棚の櫛",
  "subtitle": "お札をはがして、奥の棚の櫛を持って来い",
  "version": "2.6.0",
  "noPrewarm": true,
  "itemKinds": ["tsuge_comb"],
  "standard": "1.39",
  "theme": "dark-industrial candle-room",
  "preset": {
    "base": "horror",
    "fog": {
      "type": "exp2",
      "color": 657414,
      "density": 0.055
    },
    "far": 55,
    "background": 328707,
    "hemi": {
      "sky": 2761760,
      "ground": 1051658,
      "intensity": 0.26
    },
    "exposure": 0.8
  },
  "modules": [
    "game-core",
    "ext",
    "schema-check",
    "game-data",
    "world-from-plan",
    "plan-check",
    "task-minigames",
    "render-presets",
    "frame-guard",
    "controller",
    "ui",
    "store",
    "audio",
    "progression",
    "progress-ui",
    "inventory-ui",
    "release-notes",
    "win-manager",
    "tab-menu",
    "pause-menu",
    "journal-ui",
    "map-svg",
    "step-guide",
    "analytics"
  ],
  "minigames": [
    "trace-path",
    "timing",
    "order-steps",
    "steady-hand"
  ],
  "entry": {
    "html": "index.html",
    "main": "js/main.js"
  },
  "ext": [
    "js/ext/index.js"
  ],
  "data": {
    "plan": "data/plan.json",
    "items": "data/items.json",
    "docs": "data/docs.json",
    "tasks": "data/tasks.json",
    "stages": "data/stages.json",
    "endings": "data/endings.json",
    "releaseNotes": "data/release-notes.json",
    "monsters": "data/monsters.json",
    "things": "data/things.json",
    "talk": "data/talk.json",
    "fuda": "data/fuda.json"
  },
  "media": {
    "dir": "assets"
  },
  "fx": {
    "preset": "horror",
    "noise": 0.02,
    "scanlines": 0,
    "vignette": 1,
    "saturation": 0.6,
    "glitch": false,
    "dangerTint": true,
    "mist": true
  },
  "recipes": {
    "props": true,
    "textures": "assets/textures/"
  },
  "voice": true,
  "things": true,
  "controls": {
    "crouch": false,
    "flashlight": {
      "color": 16754784,
      "intensity": 16,
      "distance": 14,
      "angle": 0.95
    },
    "fov": 72,
    "far": 55,
    "touch": [
      {
        "k": "KeyE",
        "label": "操作",
        "cls": "big"
      },
      {
        "k": "KeyF",
        "label": "手燭"
      }
    ],
    "gateText": "今は、まだ使えない。先に、いまの目的を進めよう。"
  },
  "portraits": {
    "ハル": "assets/photos/face-haru.webp",
    "千草": "assets/photos/face-chigusa.webp",
    "野口": "assets/photos/face-noguchi.webp"
  },
  "deaths": {
    "default": {
      "text": "つかまった。",
      "sub": "最後に作業を終えた場所から、やり直す。",
      "retry": "やり直す"
    },
    "chigusa": {
      "text": "髪に、からめとられた。",
      "sub": "千草さんは、清次さんの櫛のある所へ来る。燻しの間では、煙道から来る前に廊下へ出て、戸に札を貼る。櫛を持ったら、戸の札が焦げて落ちる前に、はしごまで走る。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "やり直す"
    },
    "chase": {
      "text": "家の中で、追いつかれた。",
      "sub": "はしごを上がったら、止まらずに走る。渡り廊下・奥の間・中の間を抜けて、店の間の帳場の前へ。帳場のまわりはハルさんの札の輪で、千草さんは入れない。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "はしごの上から、やり直す"
    },
    "seal": {
      "text": "揚げ戸が、下から押し開けられた。",
      "sub": "はしごを上がったら、足もとの揚げ戸に向いて、すぐに［E］で札を貼る。",
      "photo": "assets/photos/mon-close.webp",
      "retry": "やり直す"
    }
  },
  "titleImage": "assets/photos/title.webp",
  "hud": {
    "quietFor": 60,
    "dimInDanger": true
  },
  "approach": {
    "vignette": true,
    "heartbeat": true,
    "shake": true,
    "dizzy": false,
    "presence": "breath",
    "catchImage": "assets/photos/mon-close.webp",
    "catchOn": [
      "chigusa",
      "seal"
    ]
  },
  "share": {
    "tags": [
      "札の家",
      "ホラーゲーム"
    ]
  },
  "thoughtVoices": "assets/voice/thoughts.json"
}
